{
  "name": "snakepit",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "help": "node scripts/show-help.js",
    "dev": "cross-env BUILD_WEB=1 vite --open --host",
    "dev:web": "cross-env BUILD_WEB=1 vite --open --host",
    "dev:frvr": "cross-env BUILD_FRVR=1 vite --open --host",
    "dev:google": "cross-env BUILD_GOOGLE=1 vite --open --host",
    "deploy:save-server": "node scripts/deploySaveServer.mjs",
    "build": "cross-env BUILD_WEB=1 node scripts/update-build.js",
    "build:production": "cross-env BUILD_WEB=1 node scripts/update-build.js --production",
    "build:web": "cross-env BUILD_WEB=1 node scripts/update-build.js",
    "build:frvr": "cross-env BUILD_FRVR=1 node scripts/update-build.js --production",
    "build:google": "cross-env BUILD_GOOGLE=1 node scripts/update-build.js --production",
    "build:allweb": "node scripts/update-build.js && node scripts/deploydev.mjs && node scripts/update-build.js --dont-increment-build --production && node scripts/deploy.mjs",
    "preview": "vite preview --open --host",
    "deploy": "node scripts/deploy.mjs",
    "set-project-name": "node scripts/set-project-name.mjs",
    "deploy:dev": "node scripts/deploydev.mjs",
    "deploy:termsandinfo": "node scripts/deploytermsandinfo.mjs",
    "prepare:builds": "node scripts/prepare-builds.js",
    "copy:apk": "node scripts/copy-apk.js",
    "copy:apk:release": "node scripts/copy-apk.js --release",
    "build:android": "npm run prepare:builds && npm run build && cd cordova && npm run update-game && cordova build android --debug && cd .. && npm run copy:apk && npm run install:android",
    "build:android:release": "npm run prepare:builds && npm run build && cd cordova && npm run update-game && cordova build android --release && cd .. && npm run copy:apk:release && npm run install:android:release",
    "build:ios": "node scripts/build-ios.js",
    "build:ios:release": "node scripts/build-ios.js --release",
    "open:ios": "open cordova/platforms/ios/*.xcworkspace",
    "install:android": "adb install -r builds/android-debug.apk",
    "install:android:release": "adb install -r builds/android-release.apk",
    "clean:builds": "node -e \"import('fs').then(fs=>{fs.rmSync('builds',{recursive:true,force:true});fs.mkdirSync('builds')})\"",
    "update-changelog": "node scripts/update-changelog.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.4.3",
    "cross-env": "^10.1.0",
    "ftp-deploy": "^2.4.7",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.1",
    "vite": "^5.4.1",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-qrcode": "^0.2.3",
    "vite-plugin-static-copy": "^1.0.6"
  },
  "dependencies": {
    "@pixi/ui": "^2.1.5",
    "archiver": "^7.0.1",
    "howler": "^2.2.4",
    "pixi.js": "8.9.2"
  }
}
